rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId}/sessions/{sessionId} {
      allow read, write, delete: if request.auth != null && request.auth.uid == userId;
    }
    // Public share links (src/lib/sessions.ts saveSharedSession). Write-once.
    match /shared_sessions/{shareId} {
      allow read: if true;
      allow create: if request.resource.data.version is int
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.settings is map
        && request.resource.data.layers is list
        && request.resource.data.layers.size() <= 8;
      allow update, delete: if false;
    }
    match /guestbook_entries/{entryId} {
      allow read: if true;
      allow create: if request.resource.data.name is string
        && request.resource.data.name.size() <= 50
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500
        && request.resource.data.createdAt is string
        && request.resource.data.createdAt.size() <= 40
        // Trusted time; createdAt is client-supplied (see src/lib/guestbook.ts).
        && request.resource.data.serverCreatedAt == request.time
        && request.resource.data.keys().hasOnly(['name', 'message', 'createdAt', 'serverCreatedAt']);
      allow update, delete: if false;
    }
    // Cached Freesound results, refreshed offline by scripts/refresh-freesound-pool.mjs
    // (via firebase-admin, which bypasses these rules). Used as a fallback when the
    // live Freesound API is unreachable from the server's egress IP.
    match /freesound_pool/{soundId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
